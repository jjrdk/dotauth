@model DotAuth.ViewModels.CreateClientViewModel
@{
    ViewBag.Title = "Register Client";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            const elems = document.querySelectorAll('select');
            M.FormSelect.init(elems);
        });
    </script>
}
<div class="row">
    <div class="col s12">
        <div class="card">
            <form method="post" action="@Url.ClientCreatePath()">
                @Html.AntiForgeryToken()
                <div class="card-content">
                    <div class="row">
                        <div class="col s12">
                            <h2>Create Client</h2>
                            <div class="input-field col s12">
                                <label asp-for="@Model.Name"></label>
                                <input asp-for="@Model.Name" />
                            </div>
                            <div class="input-field col s12">
                                <label asp-for="@Model.LogoUri"></label>
                                <input asp-for="@Model.LogoUri" />
                            </div>
                            <div class="input-field col s12">
                                <select asp-for="@Model.ApplicationType">
                                    <option value="" disabled selected>Choose your option</option>
                                    <option value="web">Web</option>
                                    <option value="native">Native</option>
                                </select>
                                <label>Type of client</label>
                            </div>
                            <div class="input-field col s12">
                                <label asp-for="@Model.RedirectionUrls"></label>
                                <input asp-for="@Model.RedirectionUrls" />
                            </div>
                            <div class="input-field col s12">
                                <select multiple asp-for="@Model.GrantTypes">
                                    <option value="" disabled selected>Choose grant types</option>
                                    <option value="implicit">Implicit</option>
                                    <option value="client_credentials">Client Credentials</option>
                                    <option value="authorization_code">Authorization Code</option>
                                    <option value="password">Password</option>
                                    <option value="urn:ietf:params:oauth:grant-type:uma-ticket">UMA Ticket</option>
                                    <option value="refresh_token">Refresh Token</option>
                                </select>
                                <label asp-for="@Model.GrantTypes"></label>
                            </div>
                            <div class="input-field col s12">
                                <select asp-for="@Model.TokenEndPointAuthMethod">
                                    <option value="" disabled selected>Token endpoint auth method</option>
                                    <option value="client_secret_basic">Client Secret Basic</option>
                                    <option value="client_secret_post">Client Secret Post</option>
                                    <option value="client_secret_jwt">Client Secret JWT</option>
                                    <option value="private_key_jwt">Private Key JWT</option>
                                    <option value="tls_client_auth">TLS Client Auth</option>
                                </select>
                                <label>Token End Point Auth Method</label>
                            </div>
                            <div class="input-field col s12">
                                <label asp-for="@Model.JwksUri"></label>
                                <input asp-for="@Model.JwksUri" />
                            </div>
                            <div class="input-field col s12">
                                <label asp-for="@Model.Jwks">JWKS (JSON)</label>
                                <textarea asp-for="@Model.Jwks" rows="4"></textarea>
                            </div>
                    </div>
                </div>
                <div class="card-action">
                    <div class="row">
                        <div class="col s12">
                            <button type="submit" class="waves-effect waves-light btn blue darken-3 right">Create</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
